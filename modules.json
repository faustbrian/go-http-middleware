        "responsibility": "Provide explicit, bounded server-side net/http middleware and deterministic chain composition without hidden registration or defaults.",
        "non_goals": [
          "Own routing, server lifecycle, authentication, authorization, distributed rate limiting, idempotency, telemetry backends, or application response formats.",
          "Provide a registry, service container, global default chain, background runtime, or framework bootstrap."
        ],
        "public_package_identifier": "middleware",
        "primary_entry_packages": [

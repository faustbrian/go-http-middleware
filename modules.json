        ],
        "package_selection": {
          "github.com/faustbrian/go-http-middleware": "Use to validate and compose an explicit ordered net/http middleware chain.",
          "github.com/faustbrian/go-http-middleware/adapter": "Use to name middleware ownership concerns and reject overlap with service-owned defaults.",
          "github.com/faustbrian/go-http-middleware/admission": "Use for bounded process-local in-flight admission; use go-rate-limit for distributed quotas.",
          "github.com/faustbrian/go-http-middleware/bodylimit": "Use to bound encoded request-body bytes before application decoding.",
          "github.com/faustbrian/go-http-middleware/compress": "Use for bounded HTTP gzip response negotiation and encoding.",
          "github.com/faustbrian/go-http-middleware/content": "Use for bounded request and response media-type guards without owning codecs.",
          "github.com/faustbrian/go-http-middleware/cors": "Use for explicit server-side CORS response and preflight policy, not authentication or CSRF protection.",
          "github.com/faustbrian/go-http-middleware/deadline": "Use for request deadlines or bounded buffered handler timeouts with explicit concurrency and response limits.",
          "github.com/faustbrian/go-http-middleware/middlewaretest": "Use in tests for deterministic middleware traces and ResponseWriter capability inspection.",
          "github.com/faustbrian/go-http-middleware/observe": "Use to emit bounded request-completion events without owning log or telemetry backends.",
          "github.com/faustbrian/go-http-middleware/proxy": "Use to derive peer, host, scheme, and prefix only from explicitly trusted proxy networks.",
          "github.com/faustbrian/go-http-middleware/recovery": "Use for bounded panic containment that never rewrites an already committed response.",
          "github.com/faustbrian/go-http-middleware/requestid": "Use for bounded request and correlation identifiers with explicit inbound trust policy.",
          "github.com/faustbrian/go-http-middleware/responsepolicy": "Use for deterministic no-store responses and caller-owned readiness admission.",
          "github.com/faustbrian/go-http-middleware/secureheader": "Use for explicit bounded response-security headers with acknowledged HSTS policy."
        },
